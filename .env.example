# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds secrets. It is git-ignored: NEVER commit it.

# --- CompassLLM (Gemini Live for the voice assistant, Gemini Flash for the summary) ---
COMPASS_API_KEY=
# The Compass API address, ending in /compass-api/v1, for example: https://<compass-host>/compass-api/v1
COMPASS_BASE_URL=
# COMPASS_LIVE_MODEL=gemini-3.8-live      # voice assistant model
# COMPASS_MODEL=gemini-3.8-flash          # summary model
# COMPASS_REALTIME_URL=                   # only if the realtime WebSocket is NOT <COMPASS_BASE_URL>/realtime

# --- iApp OpenThai ASR (live meeting transcript) -------------------------------------
IAPP_API_KEY=

# --- Optional ------------------------------------------------------------------------
# SEARI_STT_MODEL=mlx-community/whisper-large-v3-turbo   # local wake-word model (downloaded on first run)
# SEARI_SSH_HOSTS=host1,host2     # hosts the assistant may run SSH commands on (empty = none)
# GCAL_TZ=Asia/Bangkok            # time zone for calendar requests
# GCAL_CREDENTIALS=               # path to the Google OAuth client file (default ./credentials.json)
# GCAL_TOKEN=                     # where the Google sign-in is stored (default ./seari-token.json)
